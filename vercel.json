{
  "regions": ["sin1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "buildCommand": "cd dashboard && npm install && npm run build && cd ../mini_app && npm install && npm run build && mkdir -p ../dashboard/dist/app && cp -r dist/* ../dashboard/dist/app/",
  "outputDirectory": "dashboard/dist",
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/webhook",
      "destination": "/api/index.py"
    },
    {
      "source": "/cron-check",
      "destination": "/api/index.py"
    },
    {
      "source": "/reminder-check",
      "destination": "/api/index.py"
    },
    {
      "source": "/diag",
      "destination": "/api/index.py"
    },
    {
      "source": "/go/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/app/",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/cron-check",
      "schedule": "30 23 * * *"
    }
  ]
}
