{
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "buildCommand": "cd dashboard && npm install && npm run build",
  "outputDirectory": "dashboard/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/webhook",
      "destination": "/api/index.py"
    },
    {
      "source": "/cron-check",
      "destination": "/api/index.py"
    },
    {
      "source": "/reminder-check",
      "destination": "/api/index.py"
    },
    {
      "source": "/diag",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/cron-check",
      "schedule": "30 23 * * *"
    }
  ]
}
