# --- Telegram (တန်ဖိုးအစစ်ကို .env ထဲသာထည့်, ဒီ file က template သက်သက်) ---
TELEGRAM_TOKEN=1234567890:AAExampleTokenHere
REQUIRED_CHANNEL=@your_channel
ADMIN_CHAT_IDS=1111111111,2222222222

# --- Outline API Servers ---
OUTLINE_API_URL_1=https://SERVER1-IP:PORT/OUTLINE-API-KEY
OUTLINE_API_URL_2=https://SERVER2-IP:PORT/OUTLINE-API-KEY
OUTLINE_API_URL_3=https://SERVER3-HOST:PORT/OUTLINE-API-KEY

# --- OCR / Payment ---
OCR_API_KEY=your_ocr_space_api_key
MY_PAYMENT_PHONES=09xxxxxxxxx,09xxxxxxxxx

# --- Upstash Redis (Vercel KV) — Vercel deploy မှာ must, local မှာ မထည့်လဲ /tmp fallback နဲ့ run လို့ရ ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Local run options ---
# polling = local test အတွက်အလွယ် (webhook မလို), webhook = Flask server + public URL လို
BOT_MODE=polling
PORT=5000
# Webhook mode မှာသာ လိုသည်, ဥပမာ: https://your-app.vercel.app/
WEBHOOK_URL=

# --- Control Center (Desktop Admin Access Fallback) ---
# Desktop Browser ဖြင့် Admin Control Center သို့ ဝင်ရောက်ရန် လျှို့ဝှက် PIN/Key (Strictly enforced)
ADMIN_SECRET_KEY=your_secure_random_admin_secret_key_here

# --- Supabase Database (Free Tier Cloud PostgreSQL) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

